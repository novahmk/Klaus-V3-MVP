# URL do backend Klaus (Fastify). Ex.: http://localhost:3000 em dev.
KLAUS_API_URL=

# Deve ser IGUAL ao INTERNAL_API_KEY configurado no backend.
# Nunca prefixar com VITE_: essas variáveis só devem existir no servidor
# (usadas nas funções `createServerFn` de src/lib/klaus-api.server.ts),
# nunca no bundle enviado ao navegador.
RAILWAY_INTERNAL_API_KEY=
