# Obrigatórias — o processo não sobe sem elas (ver src/infra/config/ambiente.ts)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Mesmo valor que o dashboard usa como RAILWAY_INTERNAL_API_KEY
INTERNAL_API_KEY=
OPENAI_API_KEY=
WASENDER_API_KEY=
# Segredo compartilhado com o painel do WaSender, enviado no header x-webhook-secret
WASENDER_WEBHOOK_SECRET=

# Opcionais
OPENAI_MODEL=gpt-4o-mini
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
